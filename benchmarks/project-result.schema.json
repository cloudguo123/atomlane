{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudguo123.github.io/mac-parallel-accelerator/project-result.schema.json",
  "title": "AtomLane project benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "plugin_version",
    "category",
    "environment",
    "condition",
    "repetitions",
    "comparison",
    "parallel",
    "correctness",
    "evidence_url"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "plugin_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "category": {
      "enum": ["web", "docker-compose", "research-paper", "native-build-test", "batch-media-data-ml", "other"]
    },
    "summary": { "type": "string", "maxLength": 500 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mac", "macos", "logical_cpus", "power_source", "low_power_mode"],
      "properties": {
        "mac": { "type": "string", "maxLength": 120 },
        "macos": { "type": "string", "maxLength": 80 },
        "logical_cpus": { "type": "integer", "minimum": 1 },
        "power_source": { "enum": ["ac", "battery", "unknown"] },
        "low_power_mode": { "type": "boolean" }
      }
    },
    "condition": { "enum": ["cold", "warm", "mixed"] },
    "repetitions": { "type": "integer", "minimum": 1 },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seconds", "method"],
      "properties": {
        "kind": { "enum": ["measured_serial", "observed_sum"] },
        "seconds": { "type": "number", "exclusiveMinimum": 0 },
        "method": { "type": "string", "maxLength": 500 }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds_p50", "wall_seconds_p90", "speedup_p50", "peak_concurrency"],
      "properties": {
        "wall_seconds_p50": { "type": "number", "exclusiveMinimum": 0 },
        "wall_seconds_p90": { "type": "number", "exclusiveMinimum": 0 },
        "speedup_p50": { "type": "number", "exclusiveMinimum": 0 },
        "peak_concurrency": { "type": "integer", "minimum": 1 },
        "time_saved_seconds_p50": { "type": "number" }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked"] },
        "method": { "type": "string", "maxLength": 1000 },
        "public_hashes": { "type": "array", "items": { "type": "string", "maxLength": 128 } }
      }
    },
    "planner_blockers": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
    "evidence_url": { "type": "string", "format": "uri" }
  }
}
